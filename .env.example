# Copy this file to .env and replace placeholders locally.
# Never commit, upload, or log the real values.
OPENAI_API_KEY=your-OpenAI-API-Key-Here
ANTHROPIC_API_KEY=Your-Anthropic-API-Key-Here

# Proven v0.2 logical routes. Update only after an intentional model review.
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_ECONOMY_MODEL=gpt-5.6-terra
OPENAI_MID_MODEL=gpt-5.6-terra
ANTHROPIC_ECONOMY_MODEL=claude-sonnet-5
ANTHROPIC_MID_MODEL=claude-sonnet-5

# Cost-estimation inputs; provider invoices remain authoritative.
OPENAI_INPUT_PER_MTOK=2.50
OPENAI_OUTPUT_PER_MTOK=15.00
ANTHROPIC_INPUT_PER_MTOK=2.00
ANTHROPIC_OUTPUT_PER_MTOK=10.00

# Local runtime budgets.
DAILY_BUDGET_USD=5
MONTHLY_BUDGET_USD=150
DEFAULT_TASK_BUDGET_USD=10

OPENAI_MAX_OUTPUT_TOKENS=5000
ANTHROPIC_MAX_OUTPUT_TOKENS=5000

# Portable defaults. Relative values are resolved from this project directory.
LEDGER_PATH=ledger.db
OUTPUTS_DIR=outputs
GOAL_PATH=project/goal.md
